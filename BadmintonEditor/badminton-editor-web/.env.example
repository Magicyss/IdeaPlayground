# Badminton Video Editor - Frontend Configuration

# API Base URL
VITE_API_URL=http://localhost:8000

# Local Mode (for development)
# When enabled, shows file path input instead of upload interface
# Requires backend LOCAL_MODE=true as well
VITE_LOCAL_MODE=false

# Note: Copy this file to .env and adjust values as needed
# For local development mode:
#   VITE_LOCAL_MODE=true
